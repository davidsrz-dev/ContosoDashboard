@using ContosoDashboard.Models

@if (Document != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi @GetFileIcon(Document.ContentType) me-2"></i>
                        @Document.Title
                        <small class="text-white-50 ms-2 font-monospace fs-6">(@Document.OriginalFileName - @FormatFileSize(Document.FileSize))</small>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-0 text-center bg-light" style="min-height: 400px; max-height: 80vh; overflow-y: auto;">
                    @if (IsPdf(Document.ContentType))
                    {
                        <iframe src="/api/documents/@Document.DocumentId/stream"
                                style="width: 100%; height: 75vh; border: none;"
                                title="@Document.Title">
                        </iframe>
                    }
                    else if (IsImage(Document.ContentType))
                    {
                        <div class="p-3">
                            <img src="/api/documents/@Document.DocumentId/stream"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-height: 72vh; object-fit: contain;"
                                 alt="@Document.Title" />
                        </div>
                    }
                    else
                    {
                        <div class="py-5 px-3">
                            <i class="bi bi-file-earmark-text text-secondary" style="font-size: 4rem;"></i>
                            <h5 class="mt-3 text-dark">Previsualización en navegador no disponible</h5>
                            <p class="text-muted">
                                El formato de este archivo (@Document.ContentType) no admite previsualización directa en el navegador.
                            </p>
                            <a href="/api/documents/@Document.DocumentId/download" class="btn btn-primary mt-2" download="@Document.OriginalFileName">
                                <i class="bi bi-download me-1"></i> Descargar archivo para ver
                            </a>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-white">
                    <span class="text-muted me-auto small">
                        Subido por: <strong>@Document.UploadedByUser?.DisplayName</strong> | @Document.CreatedDate.ToLocalTime().ToString("g")
                    </span>
                    <a href="/api/documents/@Document.DocumentId/download" class="btn btn-outline-primary" download="@Document.OriginalFileName">
                        <i class="bi bi-download me-1"></i> Descargar
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Document? Document { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private bool IsPdf(string contentType) =>
        contentType.Contains("pdf", StringComparison.OrdinalIgnoreCase);

    private bool IsImage(string contentType) =>
        contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private string GetFileIcon(string contentType)
    {
        if (IsPdf(contentType)) return "bi-file-earmark-pdf text-danger";
        if (IsImage(contentType)) return "bi-file-earmark-image text-success";
        if (contentType.Contains("word") || contentType.Contains("officedocument.word")) return "bi-file-earmark-word text-primary";
        if (contentType.Contains("excel") || contentType.Contains("spreadsheet")) return "bi-file-earmark-excel text-success";
        if (contentType.Contains("presentation") || contentType.Contains("powerpoint")) return "bi-file-earmark-ppt text-warning";
        return "bi-file-earmark-text text-secondary";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1048576) return $"{(bytes / 1048576.0):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }
}
