@page "/documents"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Gestión de Documentos - ContosoDashboard</PageTitle>

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 mb-1"><i class="bi bi-folder2-open text-primary me-2"></i>Gestión de Documentos</h1>
            <p class="text-muted mb-0">Carga, organiza, comparte y previsualiza archivos de trabajo de forma segura.</p>
        </div>
        <div>
            <button class="btn btn-primary px-3 shadow-sm" @onclick="OpenUploadModal">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Subir Documento
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @statusMessageClass alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @statusMessageIcon me-2"></i>@statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Stat Badges -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold">@stats.TotalAccessibleDocuments</div>
                        <div class="small text-white-50">Total Documentos Accesibles</div>
                    </div>
                    <i class="bi bi-files fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold">@stats.PersonalDocumentsCount</div>
                        <div class="small text-white-50">Mis Documentos</div>
                    </div>
                    <i class="bi bi-person-fill fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold">@stats.ProjectDocumentsCount</div>
                        <div class="small text-white-50">Documentos de Proyecto</div>
                    </div>
                    <i class="bi bi-kanban-fill fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-secondary text-white">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4 fw-bold">@stats.SharedWithMeCount</div>
                        <div class="small text-white-50">Compartidos Conmigo</div>
                    </div>
                    <i class="bi bi-share-fill fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Controls -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center mb-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por título, etiquetas, autor..."
                               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="ClearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="selectedCategoryFilter" @bind:after="ApplyFilters">
                        <option value="">Todas las Categorías</option>
                        @foreach (var cat in DocumentCategories.All)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="selectedProjectFilter" @bind:after="ApplyFilters">
                        <option value="0">Todos los Proyectos</option>
                        @foreach (var p in availableProjects)
                        {
                            <option value="@p.ProjectId">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" title="Reiniciar Filtros" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
            <div class="row g-2 align-items-center pt-2 border-top">
                <div class="col-md-auto text-muted small fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i> Rango de Fechas (UTC inclusivo):
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted">Desde</span>
                        <input type="date" class="form-control" @bind="selectedStartDate" @bind:after="ApplyFilters" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted">Hasta</span>
                        <input type="date" class="form-control" @bind="selectedEndDate" @bind:after="ApplyFilters" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(dateValidationMessage))
                {
                    <div class="col-12">
                        <div class="text-danger small mt-1">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@dateValidationMessage
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "my" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("my")'>
                <i class="bi bi-person me-1"></i> Mis Documentos (@myDocuments.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "project" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("project")'>
                <i class="bi bi-kanban me-1"></i> Documentos de Proyecto (@projectDocuments.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "shared" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("shared")'>
                <i class="bi bi-people me-1"></i> Compartidos Conmigo (@sharedDocuments.Count)
            </button>
        </li>
        @if (isTeamLead || isAdmin)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "department" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("department")'>
                    <i class="bi bi-building me-1 text-info"></i> Documentos de Departamento (@departmentDocuments.Count)
                </button>
            </li>
        }
        @if (isAdmin)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "reports" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("reports")'>
                    <i class="bi bi-bar-chart-line-fill me-1 text-success"></i> Informes de Actividad
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "audit" ? "active fw-bold" : "")" @onclick='() => SetActiveTab("audit")'>
                    <i class="bi bi-shield-check me-1 text-danger"></i> Registro de Auditoría
                </button>
            </li>
        }
    </ul>

    <!-- Documents Table / Content -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2">Cargando documentos...</p>
        </div>
    }
    else if (activeTab == "reports" && isAdmin)
    {
        <!-- Activity Reports View -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark"><i class="bi bi-bar-chart-line-fill me-2 text-success"></i>Informe de Actividad y Cumplimiento (Solo Administradores)</h5>
                <button class="btn btn-sm btn-outline-success" @onclick="LoadActivityReport">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Informe
                </button>
            </div>
            <div class="card-body">
                <!-- Date Filter Bar -->
                <div class="row g-2 align-items-center mb-4 p-3 bg-light rounded border">
                    <div class="col-md-auto text-muted small fw-semibold">
                        <i class="bi bi-calendar-range me-1"></i> Período del Informe (UTC):
                    </div>
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white text-muted">Desde</span>
                            <input type="date" class="form-control" @bind="reportStartDate" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white text-muted">Hasta</span>
                            <input type="date" class="form-control" @bind="reportEndDate" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-success w-100" @onclick="LoadActivityReport">
                            <i class="bi bi-filter me-1"></i> Filtrar
                        </button>
                    </div>
                </div>

                @if (isReportLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-success" role="status"></div>
                        <p class="text-muted mt-2">Generando métricas y agregaciones...</p>
                    </div>
                }
                else if (activityReport != null)
                {
                    <!-- Summary Stats Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 bg-primary text-white shadow-sm p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fs-3 fw-bold">@activityReport.TotalUploads</div>
                                        <div class="small text-white-50">Total Subidas</div>
                                    </div>
                                    <i class="bi bi-cloud-arrow-up fs-1 text-white-50"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-info text-white shadow-sm p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fs-3 fw-bold">@activityReport.TotalDownloads</div>
                                        <div class="small text-white-50">Total Descargas</div>
                                    </div>
                                    <i class="bi bi-download fs-1 text-white-50"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-secondary text-white shadow-sm p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fs-3 fw-bold">@activityReport.TotalPreviews</div>
                                        <div class="small text-white-50">Visualizaciones en Línea</div>
                                    </div>
                                    <i class="bi bi-eye fs-1 text-white-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Category & MIME Breakdown -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card shadow-sm border h-100">
                                <div class="card-header bg-light fw-bold py-2">Distribución por Categoría</div>
                                <div class="card-body p-0">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            @foreach (var kvp in activityReport.DocumentsByCategory)
                                            {
                                                <tr>
                                                    <td class="ps-3">@kvp.Key</td>
                                                    <td class="text-end pe-3 fw-bold">@kvp.Value docs</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm border h-100">
                                <div class="card-header bg-light fw-bold py-2">Distribución por Tipo de Archivo (MIME)</div>
                                <div class="card-body p-0">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            @foreach (var kvp in activityReport.DocumentsByContentType)
                                            {
                                                <tr>
                                                    <td class="ps-3 font-monospace small">@kvp.Key</td>
                                                    <td class="text-end pe-3 fw-bold">@kvp.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Uploaders Table -->
                    <div class="card shadow-sm border mb-4">
                        <div class="card-header bg-light fw-bold py-2">Top Usuarios por Subidas</div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Usuario</th>
                                        <th>Departamento</th>
                                        <th class="text-center">Total Archivos</th>
                                        <th class="text-end pe-3">Volumen Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!activityReport.TopUploaders.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">No hay datos en el período seleccionado.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var u in activityReport.TopUploaders)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@u.DisplayName</td>
                                                <td><span class="badge bg-light text-dark border">@u.Department</span></td>
                                                <td class="text-center fw-bold">@u.UploadCount</td>
                                                <td class="text-end pe-3 font-monospace small">@FormatFileSize(u.TotalBytesUploaded)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Daily Activity History -->
                    <div class="card shadow-sm border">
                        <div class="card-header bg-light fw-bold py-2">Patrón de Actividad por Período</div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-center text-primary">Subidas</th>
                                        <th class="text-center text-info">Descargas</th>
                                        <th class="text-center text-secondary">Visualizaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!activityReport.DailyActivityCounts.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">Sin actividad registrada en este período.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var day in activityReport.DailyActivityCounts)
                                        {
                                            <tr>
                                                <td class="font-monospace small">@day.PeriodLabel</td>
                                                <td class="text-center fw-bold text-primary">@day.UploadCount</td>
                                                <td class="text-center fw-bold text-info">@day.DownloadCount</td>
                                                <td class="text-center fw-bold text-secondary">@day.PreviewCount</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (activeTab == "audit")
    {
        <!-- Audit Log View -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark"><i class="bi bi-shield-lock me-2 text-primary"></i>Historial de Eventos de Auditoría (Inmutable)</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAuditLogs">
                    <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha (UTC)</th>
                            <th>Acción</th>
                            <th>Usuario</th>
                            <th>Doc ID</th>
                            <th>Detalles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!auditLogs.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No hay eventos de auditoría registrados.</td></tr>
                        }
                        else
                        {
                            @foreach (var log in auditLogs)
                            {
                                <tr>
                                    <td class="font-monospace small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        <span class="badge @GetActionBadgeClass(log.ActionType)">@log.ActionType</span>
                                    </td>
                                    <td><strong>@log.User?.DisplayName</strong> <small class="text-muted">(@log.User?.Email)</small></td>
                                    <td>@(log.DocumentId.HasValue ? $"#{log.DocumentId}" : "-")</td>
                                    <td class="small text-muted">@log.Details</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        var currentList = GetCurrentTabDocuments();
        if (!currentList.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-secondary">No se encontraron documentos</h5>
                    <p class="text-muted small">No hay archivos para mostrar con los filtros aplicados o en esta sección.</p>
                    <button class="btn btn-primary btn-sm mt-1" @onclick="OpenUploadModal">
                        <i class="bi bi-upload me-1"></i> Subir el primer archivo
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th @onclick='() => Sort("Title")' style="cursor: pointer;">
                                    Título @GetSortIcon("Title")
                                </th>
                                <th @onclick='() => Sort("Category")' style="cursor: pointer;">
                                    Categoría @GetSortIcon("Category")
                                </th>
                                <th>Proyecto / Tarea</th>
                                <th @onclick='() => Sort("FileSize")' style="cursor: pointer;">
                                    Tamaño @GetSortIcon("FileSize")
                                </th>
                                <th @onclick='() => Sort("CreatedDate")' style="cursor: pointer;">
                                    Fecha @GetSortIcon("CreatedDate")
                                </th>
                                @if (activeTab == "shared")
                                {
                                    <th>Compartido por</th>
                                    <th>Fecha Compartido</th>
                                }
                                else
                                {
                                    <th>Autor</th>
                                }
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in currentList)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi @GetFileIcon(doc.ContentType) fs-4 me-2"></i>
                                            <div>
                                                <a href="javascript:void(0)" class="fw-bold text-decoration-none text-dark d-block" @onclick="() => PreviewDocument(doc)">
                                                    @doc.Title
                                                </a>
                                                <small class="text-muted font-monospace">@doc.OriginalFileName</small>
                                                @if (!string.IsNullOrEmpty(doc.Tags))
                                                {
                                                    <div class="mt-1">
                                                        @foreach (var tag in doc.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                        {
                                                            <span class="badge bg-light text-dark border me-1 small">#@tag.Trim()</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@doc.Category</span>
                                    </td>
                                    <td>
                                        @if (doc.Project != null)
                                        {
                                            <span class="d-block text-primary small"><i class="bi bi-kanban me-1"></i>@doc.Project.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Personal</span>
                                        }
                                        @if (doc.Task != null)
                                        {
                                            <span class="badge bg-light text-secondary border small mt-1">
                                                <i class="bi bi-check2-square me-1"></i>Tarea: @doc.Task.Title
                                            </span>
                                        }
                                    </td>
                                    <td class="font-monospace small text-muted">@FormatFileSize(doc.FileSize)</td>
                                    <td class="small text-muted">@doc.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    @if (activeTab == "shared")
                                    {
                                        var share = doc.Shares.FirstOrDefault(s => s.SharedWithUserId == currentUserId || (!string.IsNullOrEmpty(s.SharedWithDepartment) && s.SharedWithDepartment.Equals(currentDepartment, StringComparison.OrdinalIgnoreCase)));
                                        <td class="small">@(share?.SharedByUser?.DisplayName ?? doc.UploadedByUser?.DisplayName ?? "Sistema")</td>
                                        <td class="small text-muted">@(share != null ? share.SharedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : doc.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</td>
                                    }
                                    else
                                    {
                                        <td class="small">@doc.UploadedByUser?.DisplayName</td>
                                    }
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Previsualizar" @onclick="() => PreviewDocument(doc)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <a href="/api/documents/@doc.DocumentId/download" class="btn btn-outline-secondary" title="Descargar" download="@doc.OriginalFileName">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            @if (activeTab != "shared" && CanEditOrDelete(doc))
                                            {
                                                <button class="btn btn-outline-info" title="Compartir" @onclick="() => OpenShareModal(doc)">
                                                    <i class="bi bi-share"></i>
                                                </button>
                                                <button class="btn btn-outline-dark" title="Editar Metadatos" @onclick="() => OpenEditModal(doc)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" title="Eliminar" @onclick="() => ConfirmDeleteDocument(doc)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Preview Modal Component -->
<DocumentPreviewModal Document="selectedDocumentForPreview" OnClose="() => selectedDocumentForPreview = null" />

<!-- Upload Modal -->
@if (isUploadModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-cloud-arrow-up-fill me-2"></i>Subir Documento</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => isUploadModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (isUploading)
                    {
                        <div class="alert alert-info py-2 small mb-3" role="status">
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            Subiendo archivos seleccionados. No cierres este formulario hasta que termine.
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(uploadErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@uploadErrorMessage
                        </div>
                    }
                    @if (hasDuplicateTitleNotice)
                    {
                        <div class="alert alert-warning p-3 small mb-3 border-warning">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-exclamation-diamond-fill fs-5 me-2 text-warning"></i>
                                <div>
                                    <strong>Aviso de título duplicado:</strong> Ya existe un documento con el título "@uploadModel.Title" en esta categoría/proyecto.
                                </div>
                            </div>
                            <p class="mb-2 text-dark">¿Cómo deseas proceder?</p>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="radio" name="dupAction" id="dupNew" checked="@(duplicateAction == "new")" disabled="@isUploading" @onchange='() => duplicateAction = "new"'>
                                <label class="form-check-label" for="dupNew">
                                    <strong>Guardar como nuevo documento independiente</strong> (conserva ambos registros)
                                </label>
                            </div>
                            @if (selectedFilesToUpload.Count <= 1 && duplicateExistingDocId.HasValue)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="dupAction" id="dupReplace" checked="@(duplicateAction == "replace")" disabled="@isUploading" @onchange='() => duplicateAction = "replace"'>
                                    <label class="form-check-label" for="dupReplace">
                                        <strong>Reemplazar archivo físico existente</strong> (actualiza el documento #@duplicateExistingDocId)
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccionar archivo(s) <span class="text-danger">*</span></label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" multiple disabled="@isUploading" />
                        <small class="text-muted d-block mt-1">
                            Formatos permitidos: PDF, Word (doc/docx), Excel (xls/xlsx), PowerPoint (ppt/pptx), TXT, imágenes (JPG, PNG). Máx: 25 MB por archivo.
                        </small>
                    </div>

                    @if (selectedFilesToUpload.Any())
                    {
                        <div class="mb-3 border rounded p-2 bg-light">
                            <label class="form-label fw-bold small mb-2">Archivos seleccionados (@selectedFilesToUpload.Count):</label>
                            <div class="list-group list-group-flush" style="max-height: 180px; overflow-y: auto;">
                                @foreach (var item in selectedFilesToUpload)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-1 bg-transparent">
                                        <div class="me-2 text-truncate" style="max-width: 320px;">
                                            <i class="bi bi-file-earmark me-1 text-primary"></i>
                                            <span class="small fw-semibold">@item.BrowserFile.Name</span>
                                            <span class="text-muted small ms-1">(@FormatFileSize(item.BrowserFile.Size))</span>
                                        </div>
                                        <div>
                                            <span class="badge @item.StatusClass small">
                                                @if (item.Status == "Subiendo...")
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                }
                                                else if (item.IsSuccess)
                                                {
                                                    <i class="bi bi-check-circle me-1"></i>
                                                }
                                                else if (item.Status.StartsWith("Error"))
                                                {
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                }
                                                @item.Status
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (selectedFilesToUpload.Count <= 1)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Título del Documento <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="uploadModel.Title" @bind:after="CheckDuplicateTitle" placeholder="Ej. Plan Operativo Q3" required disabled="@isUploading" />
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Categoría <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="uploadModel.Category" disabled="@isUploading">
                                @foreach (var cat in DocumentCategories.All)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Asociar a Proyecto (Opcional)</label>
                            <select class="form-select" @bind="uploadModel.ProjectId" disabled="@isUploading">
                                <option value="">Personal / Sin Proyecto</option>
                                @foreach (var p in availableProjects)
                                {
                                    <option value="@p.ProjectId">@p.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción (Opcional)</label>
                        <textarea class="form-control" rows="2" @bind="uploadModel.Description" placeholder="Breve resumen del contenido..." disabled="@isUploading"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Etiquetas (Separadas por comas)</label>
                        <input type="text" class="form-control" @bind="uploadModel.Tags" placeholder="finanzas, 2026, borrador" disabled="@isUploading" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="() => isUploadModalOpen = false" disabled="@isUploading">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ExecuteUpload" disabled="@isUploading">
                        <i class="bi bi-upload me-1"></i> Guardar y Subir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

