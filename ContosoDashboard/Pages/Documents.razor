@code {
    private int currentUserId = 0;
    private bool isAdmin = false;
    private bool isTeamLead = false;
    private bool isLoading = true;
    private string activeTab = "my";

    private string? statusMessage;
    private string statusMessageClass = "alert-success";
    private string statusMessageIcon = "bi-check-circle-fill";

    private List<Document> myDocuments = new();
    private List<Document> projectDocuments = new();
    private List<Document> sharedDocuments = new();
    private List<Document> departmentDocuments = new();
    private List<DocumentAuditLog> auditLogs = new();
    private List<Project> availableProjects = new();
    private List<User> allUsers = new();
    private DocumentSummaryStats stats = new();

    // Search and filters
    private string searchTerm = string.Empty;
    private string selectedCategoryFilter = string.Empty;
    private int selectedProjectFilter = 0;
    private string sortColumn = "CreatedDate";
    private bool sortAscending = false;
    private DateOnly? selectedStartDate;
    private DateOnly? selectedEndDate;
    private string? dateValidationMessage;

    // Modals state
    private Document? selectedDocumentForPreview;
    private Document? selectedDocumentForEdit;
    private Document? selectedDocumentForShare;
    private Document? selectedDocumentForDelete;

    private bool isUploadModalOpen = false;
    private bool isEditModalOpen = false;
    private bool isShareModalOpen = false;
    private bool isDeleteModalOpen = false;
    private bool isUploading = false;
    private string? uploadErrorMessage;
    private bool hasDuplicateTitleNotice = false;
    private string duplicateAction = "new";
    private int? duplicateExistingDocId;

    private DocumentActivityReport? activityReport;
    private DateOnly? reportStartDate;
    private DateOnly? reportEndDate;
    private bool isReportLoading = false;

    private DocumentUploadModel uploadModel = new();
    private DocumentEditModel editModel = new();
    private IBrowserFile? selectedBrowserFile;

    private int shareUserId = 0;
    private string shareDepartment = string.Empty;
    private string currentDepartment = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (idClaim != null && int.TryParse(idClaim.Value, out int id))
        {
            currentUserId = id;
            isAdmin = user.IsInRole("Administrator");
            isTeamLead = user.IsInRole("TeamLead");
        }

        if (currentUserId > 0)
        {
            var userProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
            availableProjects = userProjects.Where(p => p.Status == ProjectStatus.Active).ToList();
            allUsers = await UserService.GetAllUsersAsync();
            var currentUserObj = allUsers.FirstOrDefault(u => u.UserId == currentUserId);
            if (currentUserObj != null)
            {
                currentDepartment = currentUserObj.Department ?? string.Empty;
            }
            await LoadAllData();
        }

        isLoading = false;
    }

    private async Task LoadAllData()
    {
        myDocuments = await DocumentService.GetUserDocumentsAsync(currentUserId);
        sharedDocuments = await DocumentService.GetSharedDocumentsAsync(currentUserId);
        stats = await DocumentService.GetDocumentStatsAsync(currentUserId);

        if (isTeamLead || isAdmin)
        {
            departmentDocuments = await DocumentService.GetDepartmentDocumentsAsync(currentUserId);
        }

        if (availableProjects.Any())
        {
            var projectDocs = new List<Document>();
            foreach (var p in availableProjects)
            {
                var docs = await DocumentService.GetProjectDocumentsAsync(p.ProjectId, currentUserId);
                projectDocs.AddRange(docs);
            }
            projectDocuments = projectDocs.DistinctBy(d => d.DocumentId).OrderByDescending(d => d.CreatedDate).ToList();
        }

        if (isAdmin && activeTab == "audit")
        {
            await LoadAuditLogs();
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "audit" && isAdmin)
        {
            _ = LoadAuditLogs();
        }
        else if (tab == "reports" && isAdmin)
        {
            _ = LoadActivityReport();
        }
    }

    private async Task LoadActivityReport()
    {
        isReportLoading = true;
        try
        {
            activityReport = await DocumentService.GetDocumentActivityReportAsync(reportStartDate, reportEndDate, currentUserId);
        }
        catch (Exception ex)
        {
            ShowStatusMessage($"Error al cargar informe de actividad: {ex.Message}", "alert-danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            isReportLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAuditLogs()
    {
        auditLogs = await DocumentService.GetDocumentAuditLogsAsync(null, currentUserId);
    }

    private List<Document> GetCurrentTabDocuments()
    {
        var list = activeTab switch
        {
            "project" => projectDocuments,
            "shared" => sharedDocuments,
            "department" => departmentDocuments,
            _ => myDocuments
        };

        if (!string.IsNullOrEmpty(selectedCategoryFilter))
        {
            list = list.Where(d => d.Category == selectedCategoryFilter).ToList();
        }

        if (selectedProjectFilter > 0)
        {
            list = list.Where(d => d.ProjectId == selectedProjectFilter).ToList();
        }

        if (string.IsNullOrEmpty(dateValidationMessage))
        {
            if (selectedStartDate.HasValue)
            {
                var startUtc = selectedStartDate.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
                list = list.Where(d => d.CreatedDate >= startUtc).ToList();
            }

            if (selectedEndDate.HasValue)
            {
                var endExclusiveUtc = selectedEndDate.Value.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
                list = list.Where(d => d.CreatedDate < endExclusiveUtc).ToList();
            }
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            list = list.Where(d =>
                d.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (d.Description != null && d.Description.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (d.Tags != null && d.Tags.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                d.OriginalFileName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (d.Project != null && d.Project.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (d.UploadedByUser != null && d.UploadedByUser.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        return sortColumn switch
        {
            "Title" => sortAscending ? list.OrderBy(d => d.Title).ToList() : list.OrderByDescending(d => d.Title).ToList(),
            "Category" => sortAscending ? list.OrderBy(d => d.Category).ToList() : list.OrderByDescending(d => d.Category).ToList(),
            "FileSize" => sortAscending ? list.OrderBy(d => d.FileSize).ToList() : list.OrderByDescending(d => d.FileSize).ToList(),
            _ => sortAscending ? list.OrderBy(d => d.CreatedDate).ToList() : list.OrderByDescending(d => d.CreatedDate).ToList(),
        };
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return string.Empty;
        return sortAscending ? "▲" : "▼";
    }

    private void HandleSearch() => StateHasChanged();
    private void ClearSearch() { searchTerm = string.Empty; StateHasChanged(); }
    private void ApplyFilters()
    {
        if (selectedStartDate.HasValue && selectedEndDate.HasValue && selectedStartDate.Value > selectedEndDate.Value)
        {
            dateValidationMessage = "La fecha inicial no puede ser posterior a la fecha final.";
        }
        else
        {
            dateValidationMessage = null;
        }
        StateHasChanged();
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        selectedCategoryFilter = string.Empty;
        selectedProjectFilter = 0;
        selectedStartDate = null;
        selectedEndDate = null;
        dateValidationMessage = null;
        StateHasChanged();
    }

    private bool CanEditOrDelete(Document doc)
    {
        if (isAdmin) return true;
        if (doc.UploadedByUserId == currentUserId) return true;
        if (doc.ProjectId.HasValue && doc.Project != null && doc.Project.ProjectManagerId == currentUserId) return true;
        return false;
    }

    private List<UploadFileItem> selectedFilesToUpload = new();

    public class UploadFileItem
    {
        public IBrowserFile BrowserFile { get; set; } = null!;
        public string Title { get; set; } = string.Empty;
        public string Status { get; set; } = "Pendiente";
        public string StatusClass { get; set; } = "bg-secondary";
        public string? ErrorMessage { get; set; }
        public bool IsCompleted { get; set; }
        public bool IsSuccess { get; set; }
    }

    // Modal Triggers
    private void PreviewDocument(Document doc) => selectedDocumentForPreview = doc;

    private void OpenUploadModal()
    {
        uploadModel = new DocumentUploadModel();
        uploadErrorMessage = null;
        hasDuplicateTitleNotice = false;
        duplicateAction = "new";
        duplicateExistingDocId = null;
        selectedBrowserFile = null;
        selectedFilesToUpload.Clear();
        isUploadModalOpen = true;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFilesToUpload.Clear();
        uploadErrorMessage = null;

        var files = e.GetMultipleFiles(maximumFileCount: 20).ToList();
        selectedBrowserFile = files.FirstOrDefault();

        foreach (var file in files)
        {
            selectedFilesToUpload.Add(new UploadFileItem
            {
                BrowserFile = file,
                Title = Path.GetFileNameWithoutExtension(file.Name),
                Status = "Pendiente",
                StatusClass = "bg-secondary"
            });
        }

        if (selectedFilesToUpload.Count == 1)
        {
            uploadModel.Title = selectedFilesToUpload[0].Title;
            await CheckDuplicateTitle();
        }
    }

    private async Task CheckDuplicateTitle()
    {
        if (!string.IsNullOrWhiteSpace(uploadModel.Title))
        {
            var cleanTitle = uploadModel.Title.Trim();
            var exists = await DocumentService.CheckDuplicateTitleAsync(cleanTitle, uploadModel.Category, uploadModel.ProjectId);
            hasDuplicateTitleNotice = exists;
            if (exists)
            {
                var existing = myDocuments.FirstOrDefault(d => d.Title.Equals(cleanTitle, StringComparison.OrdinalIgnoreCase) && d.Category == uploadModel.Category && d.ProjectId == uploadModel.ProjectId)
                    ?? projectDocuments.FirstOrDefault(d => d.Title.Equals(cleanTitle, StringComparison.OrdinalIgnoreCase) && d.Category == uploadModel.Category && d.ProjectId == uploadModel.ProjectId);
                duplicateExistingDocId = existing?.DocumentId;
            }
            else
            {
                duplicateExistingDocId = null;
                duplicateAction = "new";
            }
        }
        else
        {
            hasDuplicateTitleNotice = false;
            duplicateExistingDocId = null;
            duplicateAction = "new";
        }
    }

    private async Task ExecuteUpload()
    {
        if (!selectedFilesToUpload.Any())
        {
            uploadErrorMessage = "Por favor selecciona al menos un archivo para subir.";
            return;
        }

        if (selectedFilesToUpload.Count == 1 && string.IsNullOrWhiteSpace(uploadModel.Title))
        {
            uploadErrorMessage = "El título del documento es obligatorio.";
            return;
        }

        isUploading = true;
        uploadErrorMessage = null;
        int successCount = 0;
        int failCount = 0;

        try
        {
            foreach (var item in selectedFilesToUpload)
            {
                item.Status = "Subiendo...";
                item.StatusClass = "bg-primary";
                StateHasChanged();

                if (item.BrowserFile.Size > 26214400)
                {
                    item.Status = "Error: Excede 25 MB";
                    item.StatusClass = "bg-danger";
                    item.ErrorMessage = "El archivo supera el tamaño máximo de 25 MB.";
                    item.IsCompleted = true;
                    item.IsSuccess = false;
                    failCount++;
                    continue;
                }

                try
                {
                    using var stream = item.BrowserFile.OpenReadStream(maxAllowedSize: 26214400);
                    using var memoryStream = new MemoryStream();
                    await stream.CopyToAsync(memoryStream);
                    memoryStream.Position = 0;

                    var model = new DocumentUploadModel
                    {
                        Title = selectedFilesToUpload.Count == 1 && !string.IsNullOrWhiteSpace(uploadModel.Title) 
                            ? uploadModel.Title.Trim() 
                            : item.Title.Trim(),
                        Category = uploadModel.Category,
                        ProjectId = uploadModel.ProjectId,
                        Description = uploadModel.Description,
                        Tags = uploadModel.Tags,
                        FileStream = memoryStream,
                        FileName = item.BrowserFile.Name,
                        ContentType = item.BrowserFile.ContentType,
                        FileSize = item.BrowserFile.Size
                    };

                    if (duplicateAction == "replace" && duplicateExistingDocId.HasValue && selectedFilesToUpload.Count == 1)
                    {
                        var replaced = await DocumentService.ReplaceDocumentFileAsync(
                            duplicateExistingDocId.Value,
                            memoryStream,
                            item.BrowserFile.Name,
                            item.BrowserFile.ContentType,
                            item.BrowserFile.Size,
                            currentUserId
                        );
                        if (!replaced) throw new InvalidOperationException("No se pudo reemplazar el archivo físico o permiso denegado.");
                        item.Status = "Completado (Reemplazado)";
                    }
                    else
                    {
                        var created = await DocumentService.UploadDocumentAsync(model, currentUserId);
                        item.Status = "Completado";
                    }
                    item.StatusClass = "bg-success";
                    item.IsCompleted = true;
                    item.IsSuccess = true;
                    successCount++;
                }
                catch (Exception ex)
                {
                    item.Status = $"Error: {ex.Message}";
                    item.StatusClass = "bg-danger";
                    item.ErrorMessage = ex.Message;
                    item.IsCompleted = true;
                    item.IsSuccess = false;
                    failCount++;
                }
                StateHasChanged();
            }

            await LoadAllData();

            if (failCount == 0)
            {
                isUploadModalOpen = false;
                ShowStatusMessage(selectedFilesToUpload.Count > 1 
                    ? $"{successCount} documentos subidos exitosamente." 
                    : $"Documento subido exitosamente.", "alert-success", "bi-check-circle-fill");
            }
            else if (successCount > 0)
            {
                ShowStatusMessage($"{successCount} archivos subidos con éxito; {failCount} con error. Revise la lista para ver los detalles.", "alert-warning", "bi-exclamation-triangle-fill");
            }
            else
            {
                uploadErrorMessage = "No se pudo subir ningún archivo de la selección. Revise los errores individuales.";
            }
        }
        catch (Exception ex)
        {
            uploadErrorMessage = $"Error general al procesar la subida: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(Document doc)
    {
        selectedDocumentForEdit = doc;
        editModel = new DocumentEditModel
        {
            Title = doc.Title,
            Description = doc.Description,
            Category = doc.Category,
            ProjectId = doc.ProjectId,
            Tags = doc.Tags
        };
        isEditModalOpen = true;
    }

    private async Task SaveEditMetadata()
    {
        if (selectedDocumentForEdit == null) return;

        var success = await DocumentService.UpdateDocumentMetadataAsync(selectedDocumentForEdit.DocumentId, editModel, currentUserId);
        isEditModalOpen = false;

        if (success)
        {
            ShowStatusMessage("Metadatos actualizados correctamente.", "alert-success", "bi-check-circle-fill");
            await LoadAllData();
        }
        else
        {
            ShowStatusMessage("No se pudieron actualizar los metadatos. Permiso denegado.", "alert-danger", "bi-exclamation-triangle-fill");
        }
    }

    private void OpenShareModal(Document doc)
    {
        selectedDocumentForShare = doc;
        shareUserId = 0;
        shareDepartment = string.Empty;
        isShareModalOpen = true;
    }

    private async Task ExecuteShare()
    {
        if (selectedDocumentForShare == null) return;

        bool success = false;
        if (shareUserId > 0)
        {
            success = await DocumentService.ShareDocumentWithUserAsync(selectedDocumentForShare.DocumentId, shareUserId, currentUserId);
        }
        else if (!string.IsNullOrEmpty(shareDepartment))
        {
            success = await DocumentService.ShareDocumentWithDepartmentAsync(selectedDocumentForShare.DocumentId, shareDepartment, currentUserId);
        }

        isShareModalOpen = false;
        if (success)
        {
            ShowStatusMessage("Documento compartido correctamente.", "alert-success", "bi-check-circle-fill");
            await LoadAllData();
        }
        else
        {
            ShowStatusMessage("No se pudo compartir el documento.", "alert-danger", "bi-exclamation-triangle-fill");
        }
    }

    private void ConfirmDeleteDocument(Document doc)
    {
        selectedDocumentForDelete = doc;
        isDeleteModalOpen = true;
    }

    private async Task ExecuteDelete()
    {
        if (selectedDocumentForDelete == null) return;

        var success = await DocumentService.DeleteDocumentAsync(selectedDocumentForDelete.DocumentId, currentUserId);
        isDeleteModalOpen = false;

        if (success)
        {
            ShowStatusMessage($"Documento '{selectedDocumentForDelete.Title}' eliminado permanentemente.", "alert-success", "bi-check-circle-fill");
            await LoadAllData();
        }
        else
        {
            ShowStatusMessage("Error al eliminar el documento o permiso denegado.", "alert-danger", "bi-exclamation-triangle-fill");
        }
    }

    private void ShowStatusMessage(string msg, string cssClass, string icon)
    {
        statusMessage = msg;
        statusMessageClass = cssClass;
        statusMessageIcon = icon;
    }

    private string GetFileIcon(string contentType)
    {
        if (contentType.Contains("pdf", StringComparison.OrdinalIgnoreCase)) return "bi-file-earmark-pdf text-danger";
        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return "bi-file-earmark-image text-success";
        if (contentType.Contains("word") || contentType.Contains("officedocument.word")) return "bi-file-earmark-word text-primary";
        if (contentType.Contains("excel") || contentType.Contains("spreadsheet")) return "bi-file-earmark-excel text-success";
        if (contentType.Contains("presentation") || contentType.Contains("powerpoint")) return "bi-file-earmark-ppt text-warning";
        return "bi-file-earmark-text text-secondary";
    }

    private string GetActionBadgeClass(string action) => action switch
    {
        "Upload" => "bg-primary",
        "Download" => "bg-info text-dark",
        "Preview" => "bg-light text-dark border",
        "Share" => "bg-success",
        "Delete" => "bg-danger",
        "EditMetadata" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1048576) return $"{(bytes / 1048576.0):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }
}
