@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using ContosoDashboard.Pages
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Documentos Recientes</h5>
        <a href="/documents" class="btn btn-sm btn-outline-primary">
            Ver Todos <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2 text-muted small">Cargando documentos...</span>
            </div>
        }
        else if (!recentDocs.Any())
        {
            <div class="text-center py-4 text-muted small">
                <i class="bi bi-file-earmark-plus fs-3 d-block mb-1"></i>
                No has subido documentos recientemente.
                <div class="mt-2">
                    <a href="/documents" class="btn btn-sm btn-primary">Subir Archivo</a>
                </div>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var doc in recentDocs.Take(5))
                {
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-3">
                        <div class="d-flex align-items-center overflow-hidden me-2">
                            <i class="bi @GetFileIcon(doc.ContentType) fs-4 me-2"></i>
                            <div class="text-truncate">
                                <a href="javascript:void(0)" @onclick="() => selectedDocForPreview = doc" class="fw-bold text-dark text-decoration-none d-block text-truncate">
                                    @doc.Title
                                </a>
                                <small class="text-muted">
                                    @doc.Category &bull; @FormatFileSize(doc.FileSize) &bull; @doc.CreatedDate.ToLocalTime().ToString("MMM dd")
                                </small>
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" title="Previsualizar" @onclick="() => selectedDocForPreview = doc">
                                <i class="bi bi-eye"></i>
                            </button>
                            <a href="/api/documents/@doc.DocumentId/download" class="btn btn-outline-secondary" download="@doc.OriginalFileName" title="Descargar">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<DocumentPreviewModal Document="selectedDocForPreview" OnClose="() => selectedDocForPreview = null" />

@code {
    private List<Document> recentDocs = new();
    private bool isLoading = true;
    private Document? selectedDocForPreview;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);

        if (idClaim != null && int.TryParse(idClaim.Value, out int currentUserId) && currentUserId > 0)
        {
            recentDocs = await DocumentService.GetUserDocumentsAsync(currentUserId);
        }

        isLoading = false;
    }

    private string GetFileIcon(string contentType)
    {
        if (contentType.Contains("pdf", StringComparison.OrdinalIgnoreCase)) return "bi-file-earmark-pdf text-danger";
        if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return "bi-file-earmark-image text-success";
        if (contentType.Contains("word") || contentType.Contains("officedocument.word")) return "bi-file-earmark-word text-primary";
        if (contentType.Contains("excel") || contentType.Contains("spreadsheet")) return "bi-file-earmark-excel text-success";
        if (contentType.Contains("presentation") || contentType.Contains("powerpoint")) return "bi-file-earmark-ppt text-warning";
        return "bi-file-earmark-text text-secondary";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1048576) return $"{(bytes / 1048576.0):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }
}
